# Copia questo file in .env oppure esegui setup.command.
# Non condividere mai il file .env.

SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_LOOKBACK_DAYS=21

GLS_SITE=
GLS_CUSTOMER_CODE=
GLS_CONTRACT_CODE=
GLS_PASSWORD=
GLS_TRACK_ENDPOINT=https://wwwdr.gls-italy.com/XML/get_xml_track.php
GLS_LIST_ENDPOINT=https://labelservice.gls-italy.com/ilswebservice.asmx/ListSped
GLS_RELEASE_ENDPOINT=https://labelservice.gls-italy.com/ilswebservice.asmx/ReleaseShipmentStock
GLS_ACCEPT_UNLABELED_TRACKING=false

AUTO_SYNC=true
SYNC_INTERVAL_MINUTES=10
REQUEST_TIMEOUT_SECONDS=20
APP_HOST=127.0.0.1
APP_PORT=8787

# Consigliato se il servizio viene esposto in LAN/VPN
DASHBOARD_USER=
DASHBOARD_PASSWORD=

MOCK_MODE=false

# Numero massimo di interrogazioni GLS parallele (1-8)
SYNC_WORKERS=4

# Affidabilita tracking GLS pubblico (fallback)
GLS_PUBLIC_WORKERS=2
GLS_RETRY_ATTEMPTS=3

# ---------------------------------------------------------------
# Deploy online (Vercel + Supabase). Vedi DEPLOY.md.
# Lasciando DATABASE_URL vuoto il programma resta locale su SQLite.
# ---------------------------------------------------------------

# Stringa "Transaction pooler" di Supabase (porta 6543)
DATABASE_URL=

# Protegge /api/cron/sync, chiamato dal cron esterno
CRON_SECRET=

# Spedizioni aggiornate per esecuzione: serve dove la richiesta
# ha un tempo massimo. 0 = nessun limite.
SYNC_MAX_TRACKING=0

# Operatori della dashboard, generati con: python3 genera_utenti.py
DASHBOARD_USERS=

# Firma dei cookie di sessione (stringa casuale)
SESSION_SECRET=

# Durata dell'accesso in giorni (0 = senza scadenza)
SESSION_DAYS=30

# true: la sessione vale solo dalla rete da cui e' stato fatto l'accesso
SESSION_BIND_IP=true

# Schema dedicato, se il progetto Postgres e' condiviso con altre applicazioni
DATABASE_SCHEMA=
